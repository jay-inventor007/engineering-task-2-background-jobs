# Postgres connection string.
# Supabase: open the project, click "Connect", choose the Session pooler (port 5432). Replace
# [YOUR-PASSWORD] with the database password, and remove the square brackets. If the password
# contains @, write it as %40.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port for the API and web page. Defaults to 3000.
PORT=3000

# Every other setting has a default in src/config.ts and can be overridden here, for example:
# SIM_FAILURE_RATE=1        # make every attempt fail
# WORKER_CONCURRENCY=5
# STUCK_JOB_TIMEOUT_MS=60000
